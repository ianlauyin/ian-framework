{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/build",
			"!**/website",
			"!**/.vite",
			"!**/coverage",
			"!**/bundled-single-file"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"domains": {
			"solid": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"style": {
				"noDescendingSpecificity": "off",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["node_modules/*", "**/node_modules/*"],
								"message": "Do not import from node_modules directly."
							}
						]
					}
				}
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	}
}
