{
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 200
    },
    "javascript": {
        "formatter": {
            "trailingCommas": "es5",
            "bracketSpacing": false,
            "arrowParentheses": "asNeeded"
        }
    },
    "json": {
        "formatter": {
            "bracketSpacing": false
        }
    }
}
